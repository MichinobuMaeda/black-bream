rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveAccount() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('deletedAt', null) == null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('restrictedAt', null) == null;
    }
    function isAdmin() {
      return isActiveAccount() && request.auth.uid in get(/databases/$(database)/documents/groups/admins).data.users;
    }
    function isManager() {
      return isActiveAccount() && request.auth.uid in get(/databases/$(database)/documents/groups/managers).data.users;
    }
    function isOperator() {
      return isActiveAccount() && request.auth.uid in get(/databases/$(database)/documents/groups/operators).data.users;
    }
    match /service/conf {
      allow read, update: if isManager() || isAdmin();
      allow read: if true;
    }
    match /service/auth {
      allow read, update: if isAdmin();
    }
    match /logs/{log} {
      allow read: if isAdmin();
    }
    match /users/{user} {
      allow read, create, update: if isManager();
      allow read, update: if isActiveAccount() && request.auth.uid == user;
      allow read: if isActiveAccount();
    }
    match /groups/{group} {
      allow read, create, update: if isManager();
      allow read: if isActiveAccount();
    }
    match /posts/{post} {
      allow read, create, update: if isOperator();
      allow read, update: if isManager();
      allow read: if isActiveAccount();
    }
    match /templates/{template} {
      allow read, create, update: if isManager() || isOperator();
      allow read: if isActiveAccount();
    }
    match /generators/{generator} {
      allow read, create, update: if isManager() || isOperator();
      allow read: if isActiveAccount();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
