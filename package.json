{
  "name": "black-bream",
  "private": true,
  "version": "1.9.0",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Michinobu Maeda",
    "email": "michinobumaeda@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichinobuMaeda/black-bream"
  },
  "scripts": {
    "dev": "vite --port 8000",
    "lint": "eslint",
    "build": "vite build",
    "start": "npx firebase emulators:exec --only functions,storage,auth,firestore,tasks --ui 'npm run test:data && npm run dev'",
    "test:data": "curl -X POST -H 'Content-Type: application/json' -d '{\"data\":{}}' http://127.0.0.1:5001/black-bream/asia-northeast2/uiTestData",
    "test": "vitest --run",
    "test:firestore": "npx firebase emulators:exec --only firestore,auth --import test/firestore/data 'npx vitest --run --config vitest.config.firestore.ts 2>/dev/null'",
    "prettier:check": "npx prettier -c src functions",
    "prettier:fix": "npx prettier -w src functions",
    "actions:list": "gh run list --limit 5",
    "preview": "vite preview"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@date-fns/utc": "^2.1.1",
    "@tailwindcss/vite": "^4.1.12",
    "cheerio": "^1.1.2",
    "date-fns": "^4.1.0",
    "firebase": "^12.2.1",
    "i18next": "^25.4.2",
    "js-yaml": "^4.1.0",
    "mammoth": "^1.10.0",
    "marked": "^16.2.1",
    "nanoid": "^5.1.5",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.7.3",
    "react-router": "^7.8.2",
    "tailwindcss": "^4.1.12",
    "tailwindcss-safe-area": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/css": "^0.11.0",
    "@eslint/js": "^9.34.0",
    "@eslint/json": "^0.13.2",
    "@eslint/markdown": "^7.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-plugin-jsdoc": "^54.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "firebase-tools": "^14.15.1",
    "globals": "^15.15.0",
    "prettier": "3.6.2",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "sharp": "0.32.6",
    "sharp-ico": "0.1.5"
  }
}
